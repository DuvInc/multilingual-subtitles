# Transcription. Get a key at https://console.mistral.ai
#
# Used by `subs transcribe`. The audio is uploaded to Mistral and the words
# come back with timestamps. Nothing else reads this key.
MISTRAL_API_KEY=your-key-here

# Which Mistral model transcribes. voxtral-mini-latest is the cheap one and is
# what this tool was tested against. voxtral-small-latest is more accurate on
# hard audio.
MISTRAL_MODEL=voxtral-mini-latest

# Translation. Only needed for `subs translate`.
#
# Leave it empty if you authenticate the CLI instead, with `aiglot auth login`.
# The CLI reads this variable before its keychain, so setting it here overrides
# an interactive login.
AIGLOT_API_KEY=

# "cli" (default) shells out to the aiglot CLI. "api" talks to the REST API
# with fetch and no install.
AIGLOT_TRANSPORT=cli

# "lite" is one credit per three words and is right for subtitles. "standard"
# is one per word.
AIGLOT_QUALITY=lite
